const MOVE_SPEED = 6.0;
const JUMP_VELOCITY = 5.0;

fn update(world: World) {
    let gameplay = world.is_context_active("gameplay");

    let mut move_x = 0.0;
    let mut move_y = 0.0;
    let mut look_x = 0.0;
    let mut look_y = 0.0;
    let mut should_jump = false;

    if gameplay {
        let move_input = world.input_vector_2d("Left", "Right", "Forwards", "Backwards");
        move_x = move_input.x;
        move_y = move_input.y;

        let delta = world.mouse_delta();
        look_x = delta.x;
        look_y = delta.y;

        should_jump = world.is_keybind_active("Jump");

        if world.is_keybind_active("Delete") {
            let hit = world.raycast_camera(100.0);
            if hit.is_some() {
                world.despawn(hit.unwrap().entity);
            }
        }
    }

    for row in world.query.with("Transform").with_tag("Player").fetch() {
        let mut t = row.transform;
        t.euler_angles = vec3(t.euler_angles.x, t.euler_angles.y - look_x, t.euler_angles.z);
        world.set_transform(row.entity, t);
    }

    for row in world.query.with("Transform").with_tag("ActiveCamera").fetch() {
        let mut t = row.transform;
        let pitch = (t.euler_angles.x - look_y).max(0.0 - 89.0).min(89.0);
        t.euler_angles = vec3(pitch, t.euler_angles.y, t.euler_angles.z);
        world.set_transform(row.entity, t);
    }

    let len = (move_x * move_x + move_y * move_y).sqrt();
    let mut nx = move_x;
    let mut ny = move_y;
    if len > 1.0 {
        nx = nx / len;
        ny = ny / len;
    }
    for row in world.query.with("Transform").with("Velocity").with_tag("Player").fetch() {
        let wish = row.transform.rotate(vec3(nx, 0.0, 0.0 - ny));

        let mut v = row.velocity;
        v.linear_velocity = vec3(wish.x * MOVE_SPEED, v.linear_velocity.y, wish.z * MOVE_SPEED);

        if should_jump {
            if v.is_grounded {
                v.linear_velocity = vec3(v.linear_velocity.x, JUMP_VELOCITY, v.linear_velocity.z);
            }
        }

        world.set_velocity(row.entity, v);
    }
}
