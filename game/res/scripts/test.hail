// Exercises the engine API: entities, components, transforms, tags, queries.
// Each check logs PASS/FAIL; watch the console on game start.

fn check(world: World, label: String, ok: bool) {
    if ok {
        world.log("PASS " + label);
    } else {
        world.log("FAIL " + label);
    }
}

fn start(world: World) {
    world.log("-- hail api tests --");

    // Entity lifecycle: a fresh spawn carries no components.
    let e = world.spawn();
    world.set_name(e, "hail_test_entity");
    check(world, "spawn is bare", world.has_component(e, "Transform") == false);
    check(world, "get_transform is none", world.get_transform(e).is_none());

    // By-name component add.
    world.add_component(e, "Transform");
    check(world, "add_component", world.has_component(e, "Transform"));
    check(world, "get_transform is some", world.get_transform(e).is_some());

    // Transform snapshot roundtrip: mutate locally, write back, re-read.
    let mut t = world.get_transform(e).unwrap();
    t.position = vec3(1.0, 2.0, 3.0);
    t.euler_angles = vec3(0.0, 90.0, 0.0);
    t.scale = vec3(2.0, 2.0, 2.0);
    world.set_transform(e, t);

    let t2 = world.get_transform(e).unwrap();
    check(world, "position roundtrip", t2.position.x == 1.0);
    check(world, "position y", t2.position.y == 2.0);
    check(world, "euler roundtrip", t2.euler_angles.y == 90.0);
    check(world, "scale roundtrip", t2.scale.z == 2.0);

    // Vec3 field setters on a local value.
    let mut v = vec3(0.0, 0.0, 0.0);
    v.y = 4.5;
    check(world, "vec3 setter", v.y == 4.5);

    // Tags: transient add/remove within start, so no system ever sees it.
    check(world, "has_tag before add", world.has_tag(e, "Player") == false);
    world.add_tag(e, "Player");
    check(world, "add_tag", world.has_tag(e, "Player"));
    world.remove_tag(e, "Player");
    check(world, "remove_tag", world.has_tag(e, "Player") == false);

    // Queries: our entity must show up, and yielded handles must be usable.
    let mut found_usable = false;
    for other in world.entities_with("Transform") {
        if world.get_transform(other).is_some() {
            found_usable = true;
        }
    }
    check(world, "entities_with yields usable handles", found_usable);

    // Entity equality.
    check(world, "entity equals itself", e == e);

    // Query builder: component filter finds our entity.
    let mut hit = false;
    for other in world.query.with("Transform").run() {
        if other == e {
            hit = true;
        }
    }
    check(world, "query.with finds entity", hit);

    // Tag filters, transient again.
    world.add_tag(e, "Player");
    hit = false;
    for other in world.query.with("Transform").with_tag("Player").run() {
        if other == e {
            hit = true;
        }
    }
    check(world, "query.with_tag finds entity", hit);

    hit = false;
    for other in world.query.with("Transform").without_tag("Player").run() {
        if other == e {
            hit = true;
        }
    }
    check(world, "query.without_tag excludes entity", hit == false);
    world.remove_tag(e, "Player");

    // Rotation: a fresh transform has identity global rotation.
    let rt = world.get_transform(e).unwrap();
    let rotated = rt.rotate(vec3(1.0, 0.0, 0.0));
    check(world, "identity rotate", rotated.x == 1.0);

    // Velocity snapshot roundtrip.
    world.add_component(e, "Velocity");
    check(world, "add velocity", world.get_velocity(e).is_some());
    let mut vel = world.get_velocity(e).unwrap();
    vel.linear_velocity = vec3(3.0, 0.0, 0.0);
    world.set_velocity(e, vel);
    check(world, "velocity roundtrip", world.get_velocity(e).unwrap().linear_velocity.x == 3.0);

    // Input: just exercise the calls (no keys held during start).
    let jump = world.is_keybind_active("Jump");
    check(world, "keybind callable", jump == jump);
    let mv = world.input_vector_2d("Left", "Right", "Forwards", "Backwards");
    let md = world.mouse_delta();
    check(world, "input vectors callable", mv.x == mv.x);
    check(world, "vec2 fields", md.y == md.y);

    // Engine resources.
    check(world, "delta_time non-negative", world.delta_time >= 0.0);
    check(world, "time non-negative", world.time >= 0.0);
    let ws = world.window_size;
    check(world, "window_size readable", ws.x >= 0.0);

    // Cleanup.
    world.despawn(e);
    check(world, "despawned entity has no components", world.has_component(e, "Transform") == false);

    world.log("-- hail api tests done --");
}
